# 阿里云百炼 API 配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=qwen-plus-latest
DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# Qwen-ASR FileTrans：enable_words 返回真实词/字级时间戳
DASHSCOPE_ASR_ENABLE_WORD_TIMESTAMPS=true
DASHSCOPE_ASR_FILETRANS_MODEL=qwen3-asr-flash-filetrans
DASHSCOPE_ASR_FILETRANS_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_FILETRANS_FILE_URL=
DASHSCOPE_ASR_FILETRANS_AUTO_UPLOAD=true

# 阿里云 ASR 服务配置
ALIYUN_ASR_APP_KEY=your_asr_app_key_here
ALIYUN_ASR_ACCESS_KEY_ID=your_access_key_id_here
ALIYUN_ASR_ACCESS_KEY_SECRET=your_access_key_secret_here