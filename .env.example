# DashScope, used for LLM and Aliyun fallback ASR.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_LLM_MODEL=deepseek-v4-pro
DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# Qwen-ASR FileTrans is supported but disabled by default unless your key has permission.
DASHSCOPE_ASR_ENABLE_WORD_TIMESTAMPS=false
DASHSCOPE_ASR_FILETRANS_MODEL=qwen3-asr-flash-filetrans
DASHSCOPE_ASR_FILETRANS_API_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_FILETRANS_FILE_URL=
DASHSCOPE_ASR_FILETRANS_AUTO_UPLOAD=false

# Local FunASR primary ASR provider.
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_DEVICE=cpu
FUNASR_SENTENCE_TIMESTAMP=true
